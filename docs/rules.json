{
  "version": "poc-1",
  "_comment": "Single source of truth for every threshold, weight, window and hysteresis setting. Ramps: [a, b] goes 0 at a to 1 at b (a > b means falling). Trapezoids: [a, b, c, d] rise a->b, flat 1 between b and c, fall c->d. Signals with \"required\": true multiply the state score by their match (0-1), so the state cannot win without them.",
  "detection": {
    "model": "lite0",
    "models": {
      "lite0": "models/efficientdet_lite0.tflite",
      "lite2": "models/efficientdet_lite2.tflite"
    },
    "inferenceFps": 10,
    "scoreThreshold": 0.3,
    "maxResults": 5,
    "preferredLabels": [
      "dog"
    ],
    "fallbackLabels": [
      "cat",
      "sheep",
      "bear",
      "teddy bear",
      "cow",
      "horse"
    ],
    "boxSmoothing": 0.5,
    "gpuFallbackMs": 100,
    "gpuFallbackAfterFrames": 5
  },
  "motion": {
    "gridWidth": 96,
    "pixelDiffThreshold": 14,
    "maxShift": 3
  },
  "gates": {
    "minAreaFrac": 0.03,
    "maxAreaFrac": 0.75,
    "minDetScore": 0.35,
    "minPresenceFraction": 0.6,
    "maxCameraMotion": 0.25,
    "minEvidenceFraction": 0.5,
    "minTopScore": 0.4
  },
  "windows": {
    "featureSeconds": 2.0,
    "nowSeconds": 1.0,
    "prevFromSeconds": 4.0,
    "prevToSeconds": 1.5,
    "heightRefFromSeconds": 6.0,
    "heightRefToSeconds": 2.5,
    "historySeconds": 8.0
  },
  "baselineDefaults": {
    "motion": 0.02,
    "aspect": 1.5,
    "speed": 0.05
  },
  "baselineFloors": {
    "motion": 0.01
  },
  "calibration": {
    "seconds": 15,
    "minValidFraction": 0.6
  },
  "sensitivity": {
    "_comment": "Multiplies the motion ramps' thresholds. Higher sensitivity = smaller changes count.",
    "low": 1.3,
    "normal": 1.0,
    "high": 0.75
  },
  "states": {
    "resting": {
      "label": "Resting",
      "signals": [
        {
          "feature": "motionRel",
          "ramp": [
            1.2,
            0.4
          ],
          "weight": 2.0,
          "reason": "very little movement",
          "required": true
        },
        {
          "feature": "aspect",
          "ramp": [
            1.3,
            1.9
          ],
          "weight": 1.5,
          "reason": "body low and stretched out, like lying down"
        },
        {
          "feature": "speed",
          "ramp": [
            0.1,
            0.02
          ],
          "weight": 1.0,
          "reason": "staying in one place"
        }
      ]
    },
    "relaxed": {
      "label": "Relaxed",
      "signals": [
        {
          "feature": "motionRel",
          "trapezoid": [
            0.3,
            0.7,
            2.0,
            3.5
          ],
          "weight": 2.0,
          "reason": "moving about as much as his relaxed baseline",
          "required": true
        },
        {
          "feature": "speed",
          "ramp": [
            0.4,
            0.1
          ],
          "weight": 1.0,
          "reason": "not moving around the room much"
        },
        {
          "feature": "heightChange",
          "trapezoid": [
            -0.2,
            -0.06,
            0.06,
            0.2
          ],
          "weight": 1.0,
          "reason": "body height steady"
        },
        {
          "feature": "freeze",
          "ramp": [
            0.6,
            0.1
          ],
          "weight": 1.0,
          "reason": "no sudden freezes"
        }
      ]
    },
    "alert": {
      "label": "Alert",
      "signals": [
        {
          "feature": "freeze",
          "ramp": [
            0.2,
            0.7
          ],
          "weight": 2.0,
          "reason": "suddenly went still after moving"
        },
        {
          "feature": "heightChange",
          "ramp": [
            0.04,
            0.18
          ],
          "weight": 2.0,
          "reason": "head or body raised compared with a moment ago"
        },
        {
          "feature": "aspect",
          "ramp": [
            1.35,
            1.0
          ],
          "weight": 1.0,
          "reason": "upright (sitting or standing tall)"
        },
        {
          "feature": "motionNowRel",
          "ramp": [
            1.0,
            0.35
          ],
          "weight": 1.0,
          "reason": "holding still right now"
        }
      ]
    },
    "active": {
      "label": "Active / excited",
      "signals": [
        {
          "feature": "motionRel",
          "ramp": [
            1.5,
            4.0
          ],
          "weight": 2.0,
          "reason": "much more movement than his relaxed baseline",
          "required": true
        },
        {
          "feature": "speed",
          "ramp": [
            0.2,
            0.8
          ],
          "weight": 1.5,
          "reason": "moving around the room"
        },
        {
          "feature": "aspectVar",
          "ramp": [
            0.05,
            0.25
          ],
          "weight": 1.0,
          "reason": "body shape changing quickly (wiggling, bouncing, turning)"
        }
      ]
    }
  },
  "stateMachine": {
    "scoreSmoothingSeconds": 1.5,
    "minDwellSeconds": 1.5,
    "switchMargin": 0.08,
    "unclearDwellSeconds": 1.0,
    "maxReasons": 3
  }
}